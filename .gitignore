# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.tmp/
# Checkout-local tool state; never publish.
/.openai/
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

*.tsbuildinfo

# local tooling
.claude/
.idea/
.vscode/

# Local release logs created by audit and deployment commands.
/*-build.txt
/*-deploy.txt
/audit-*.txt
/outputs-audit-*.txt
/deploy-*-result.txt

# Local investigation and recovery notes; retained on the workstation only.
/CODEX-HANDOFF.md
/outputs-recovered.json
/repair-installed-output.sql
/scripts/audit-advisory-details.mjs
/scripts/audit-existing-purchase.mjs
/scripts/audit-final-summary.mjs
/scripts/audit-ledger-read.mjs
/scripts/audit-pin-archive-patch.mjs
/scripts/audit-ui-cleanup.mjs
/scripts/audit-whitespace.mjs
/scripts/check-*.mjs
/scripts/sim-*.mjs
/scripts/trace-*.mjs
/scripts/update-current-release-copy.mjs
